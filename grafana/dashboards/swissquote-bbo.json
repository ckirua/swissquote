        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "swissquote-clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "sql",
          "rawSql": "SELECT\n  toStartOfMinute(ts) AS time,\n  argMax(toFloat64(bid_price), ts) AS bid,\n  argMax(toFloat64(ask_price), ts) AS ask,\n  argMax(mid, ts) AS mid\nFROM (\n  SELECT ts, bid_price, ask_price, mid\n  FROM (\n    SELECT\n      ts,\n      bid_price,\n      ask_price,\n      mid,\n      median(mid) OVER (PARTITION BY toDate(ts)) AS day_med\n    FROM swissquote.bbo_mv\n    WHERE $__timeFilter_ms(ts)\n      AND symbol = '${symbol}'\n      AND spread_profile = '${spread_profile}'\n      AND ('${server}' = 'All' OR server = '${server}')\n      AND toFloat64(bid_price) > 0\n      AND toFloat64(ask_price) > 0\n      AND ask_price >= bid_price\n      AND (\n        '${axis}' = 'calendar'\n        OR NOT multiIf(\n          toDayOfWeek(toTimeZone(ts, 'America/New_York')) = 5,\n            (toHour(toTimeZone(ts, 'America/New_York')) * 60\n              + toMinute(toTimeZone(ts, 'America/New_York'))) >= 16 * 60 + 55,\n          toDayOfWeek(toTimeZone(ts, 'America/New_York')) = 6, 1,\n          toDayOfWeek(toTimeZone(ts, 'America/New_York')) = 7,\n            (toHour(toTimeZone(ts, 'America/New_York')) * 60\n              + toMinute(toTimeZone(ts, 'America/New_York'))) < 16 * 60 + 50,\n          0\n        )\n      )\n      AND (\n        '${clean}' = 'no'\n        OR (spread_bps IS NULL OR abs(spread_bps) < 100)\n      )\n  )\n  WHERE\n    '${clean}' = 'no'\n    OR (day_med > 0 AND abs(mid / day_med - 1) <= 0.05)\n)\nGROUP BY time\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Bid / Ask / Mid (1m last)",
      "type": "timeseries"
    },
