          "editorType": "sql",
          "format": 0,
          "queryType": "sql",
          "rawSql": "SELECT\n  toStartOfMinute(ingestion_time) AS time,\n  avg(dateDiff('ms', ts, ingestion_time)) AS ingestion_lag_ms\nFROM swissquote.bbo_mv\nWHERE $__timeFilter_ms(ingestion_time)\n  AND symbol = '${symbol}'\n  AND spread_profile = '${spread_profile}'\n  AND ('${server}' = 'All' OR server = '${server}')\n  AND (\n    '${clean_lag}' = 'no'\n    OR (\n      dateDiff('ms', ts, ingestion_time) >= 0\n      AND dateDiff('ms', ts, ingestion_time) < 60000\n    )\n  )\nGROUP BY time\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Ingestion lag (avg ms)",
      "type": "timeseries",
      "description": "Avg ingestion_time \u2212 ts per minute. Clean lag=yes drops absurd outliers (\u226560s) so the axis stays in seconds-scale; set Clean lag=no to see raw spikes (can reach days)."
