[Unit]
Description=Swissquote BBO feed (Unix SOCK_SEQPACKET publisher) @INSTALL_ROOT@
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_USER@
RuntimeDirectory=@RUN_DIRECTORY@
RuntimeDirectoryMode=0750
UMask=0007

WorkingDirectory=@INSTALL_ROOT@
EnvironmentFile=-@ENV_PATH@
Environment=DOTENV_PATH=@ENV_PATH@
ExecStart=@INSTALL_ROOT@/bin/swissquote-feed --config @CONFIG_PATH@

Restart=on-failure
RestartSec=5
TimeoutStopSec=30

KillSignal=SIGTERM
KillMode=mixed

StandardOutput=journal
StandardError=journal
SyslogIdentifier=swissquote-feed@UNIT_SUFFIX@

[Install]
WantedBy=multi-user.target
