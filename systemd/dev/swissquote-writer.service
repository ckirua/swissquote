[Unit]
Description=Swissquote BBO writer (Unix SOCK_SEQPACKET subscriber to ClickHouse)
After=network-online.target swissquote-feed.service
Wants=network-online.target

[Service]
Type=simple
User=swissquote
Group=swissquote

WorkingDirectory=/home/swissquote/projects/swissquote
EnvironmentFile=-/home/swissquote/.env
ExecStart=/home/swissquote/.local/bin/swissquote-writer \
    --config /home/swissquote/projects/swissquote/systemd/dev/service.toml

Restart=on-failure
RestartSec=5
TimeoutStopSec=30

KillSignal=SIGTERM
KillMode=mixed

StandardOutput=journal
StandardError=journal
SyslogIdentifier=swissquote-writer

[Install]
WantedBy=multi-user.target
