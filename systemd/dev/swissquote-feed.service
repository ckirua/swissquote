[Unit]
Description=Swissquote BBO feed (Unix SOCK_SEQPACKET publisher)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=swissquote
Group=swissquote
RuntimeDirectory=swissquote-dev
RuntimeDirectoryMode=0750
UMask=0007
ExecStart=/home/swissquote/.local/bin/swissquote-feed \
    --config /home/swissquote/projects/swissquote/systemd/dev/service.toml
EnvironmentFile=-/home/swissquote/.env

Restart=on-failure
RestartSec=5
TimeoutStopSec=30

KillSignal=SIGTERM
KillMode=mixed

StandardOutput=journal
StandardError=journal
SyslogIdentifier=swissquote-feed

[Install]
WantedBy=multi-user.target
